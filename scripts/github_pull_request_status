#!/bin/sh

request_body=$(cat <<EOF
{
  "state": "$1",
  "description": "$2",
  "target_url": "$3",
  "context": "$4"
}
EOF
)

# Sets api_code, api_body (file), api_remaining and api_retry_after. The caller
# removes api_body.
api_call() {
    api_body="$(mktemp)"
    api_hdr="$(mktemp)"
    api_code="$(curl -sS -o "$api_body" -D "$api_hdr" -w '%{http_code}' \
                  -H "Authorization: bearer $GITHUB_BOT_TOKEN_REPO_STATUS" "$@")"
    api_remaining="$(sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]emaining: *\([0-9]*\).*/\1/p' "$api_hdr" | tail -1)"
    api_retry_after="$(sed -n 's/^[Rr]etry-[Aa]fter: *\([0-9]*\).*/\1/p' "$api_hdr" | tail -1)"
    rm -f "$api_hdr"
}

api_throttled() {
    case "$api_code" in
        403|429)
            [ "$api_remaining" = "0" ] || [ -n "$api_retry_after" ]
            ;;
        *)
            return 1
            ;;
    esac
}

# Special case for mender-qa running in Gitlab: It builds a specific branch, not
# by setting the MENDER_QA_REV variables, but by simply checking out that
# branch. It is recorded in the "CI_*" variables though.
if [ "$CI_PROJECT_NAME" = "mender-qa" ]; then
    if echo "$CI_COMMIT_REF_NAME" | egrep '^pr_[0-9]+$'; then
        export MENDER_QA_REV="pull/$(echo "$CI_COMMIT_REF_NAME" | egrep -o '[0-9]+')/merge"
    else
        export MENDER_QA_REV="$CI_COMMIT_REF_NAME"
    fi
fi

# Split on newlines
IFS='
'
for key in $(env | sed -e 's/=.*//'); do
    if ! echo $key | egrep -q "_REV"; then
        # Not a Mender repo variable
        continue
    fi
    if echo $key | egrep -q "^DOCKER_ENV_"; then
        # Skip GitLab/Docker duplicated environment vars, i.e. MENDER_REV has a DOCKER_ENV_MENDER_REV
        continue
    fi
    if ! eval echo \$$key | egrep -q "^pull/[0-9]+/(head|merge)$"; then
        # Not a pull request, skip.
        continue
    fi

    repo=$(echo ${key%_REV} | tr '[A-Z_]' '[a-z-]')
    sha_endpoint=""
    if [ -n "$(eval echo \$${key}_GIT_SHA)" ]; then
        # GitLab script defines env variables with _GIT_SHA suffix for the PR commit under test
        git_commit="$(eval echo \$${key}_GIT_SHA)"
    else
        # Use Github API to fetch commit SHAs
        eval sha_endpoint=https://api.github.com/repos/mendersoftware/$repo/status/\$${key}
        echo "Querying API: $sha_endpoint"
        api_call "$sha_endpoint"
        if [ "$api_code" != "200" ]; then
            if api_throttled; then
                echo "msg=github_sha_lookup result=rate_limited repo=$repo code=$api_code remaining=${api_remaining:-0} retry_after=${api_retry_after:-0}" 1>&2
            else
                echo "msg=github_sha_lookup result=failed repo=$repo code=$api_code" 1>&2
                cat "$api_body" 1>&2
            fi
            rm -f "$api_body"
            continue
        fi
        git_commit="$(jq -r '.sha' < "$api_body")"
        rm -f "$api_body"
        if [ -z "$git_commit" ] || [ "$git_commit" = "null" ]; then
            echo "msg=github_sha_lookup result=no_sha repo=$repo" 1>&2
            continue
        fi
    fi
    pr_status_endpoint=https://api.github.com/repos/mendersoftware/$repo/statuses/$git_commit

    # Print the variables
    echo "Reporting GitHub status for:"
    echo "    key=$key"
    echo "    repo=$repo"
    echo "    sha_endpoint=$sha_endpoint"
    echo "    git_commit=$git_commit"
    echo "    pr_status_endpoint=$pr_status_endpoint"
    echo "    request_body:"
    echo "$request_body"
    echo

    api_call -d "$request_body" "$pr_status_endpoint"
    case "$api_code" in
        2??)
            if [ -n "$api_remaining" ]; then
                echo "msg=github_status_update result=ok repo=$repo remaining=$api_remaining"
            fi
            ;;
        *)
            if api_throttled; then
                echo "msg=github_status_update result=rate_limited repo=$repo code=$api_code remaining=${api_remaining:-0} retry_after=${api_retry_after:-0}" 1>&2
            elif grep -q "This SHA and context has reached the maximum number of statuses" "$api_body"; then
                :
            else
                echo "msg=github_status_update result=failed repo=$repo code=$api_code" 1>&2
                cat "$api_body" 1>&2
            fi
            ;;
    esac
    rm -f "$api_body"
done

IFS=' '
